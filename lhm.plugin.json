{
  "identifier": "fatwang2-search1api-mcp",
  "name": "Search1API MCP Server",
  "version": "0.8.0",
  "author": "Search1API",
  "authorUrl": "https://github.com/superagents-lab",
  "homepage": "https://github.com/superagents-lab/search1api-mcp",
  "cloudEndpoint": "https://mcp.search1api.com/mcp",
  "category": "web-search",
  "description": "Official Search1API MCP server for web search, agentic search, news search, page crawling, sitemap discovery, and trending topics. Use the hosted server with OAuth 2.1 or an API key, or run it locally with npm.",
  "localizations": [
    {
      "description": "Search1API 官方 MCP 服务，提供网页搜索、智能搜索、新闻检索、网页抓取、站点地图和热门话题能力。支持通过 OAuth 2.1 或 API Key 使用托管服务，也可通过 npm 本地运行。",
      "locale": "zh-CN",
      "name": "Search1API MCP 服务",
      "tags": [
        "Search1API",
        "网页搜索",
        "新闻检索",
        "网页抓取",
        "站点地图",
        "远程 MCP",
        "OAuth"
      ]
    }
  ],
  "resources": [
    {
      "uri": "search1api://info",
      "name": "Search1API Information",
      "description": "Basic information about Search1API capabilities",
      "mimeType": "application/json"
    }
  ],
  "tags": [
    "search1api",
    "web-search",
    "news",
    "web-crawling",
    "sitemap",
    "remote-mcp",
    "oauth"
  ],
  "tools": [
    {
      "name": "search",
      "title": "Web search",
      "description": "Search the live public web when the user needs current information, sources, or research. Returns citable results with id, title, URL, and text. Each result includes a URL that can be read in full.",
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": []
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ],
        "openai/toolInvocation/invoking": "Searching the web…",
        "openai/toolInvocation/invoked": "Search results"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Short, focused search query"
          },
          "max_results": {
            "type": "number",
            "minimum": 1,
            "maximum": 50,
            "description": "How many sources the answer needs; a handful suits most questions, more suits a broad survey",
            "default": 10
          },
          "search_service": {
            "type": "string",
            "description": "Search engine to use; choose one only when it matches the user's source intent",
            "default": "google",
            "enum": [
              "google",
              "bing",
              "bingcn",
              "duckduckgo",
              "yahoo",
              "yandex",
              "x",
              "reddit",
              "github",
              "youtube",
              "arxiv",
              "wechat",
              "bilibili",
              "imdb",
              "wikipedia",
              "grokipedia"
            ]
          },
          "page": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "description": "Which page of results to fetch when the first page was not enough; only bing, bingcn, and grokipedia paginate, other engines ignore it",
            "default": 1
          },
          "crawl_results": {
            "type": "number",
            "minimum": 0,
            "description": "How many top results to also read in full, so their text holds the whole page instead of a snippet. Each successful page retrieval adds 1 credit to the base 1-credit search request",
            "default": 0
          },
          "include_sites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Domains to include when the user explicitly scopes the search",
            "default": []
          },
          "exclude_sites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Domains to exclude from the search",
            "default": []
          },
          "time_range": {
            "type": "string",
            "description": "Restrict results to those published recently, for time-sensitive questions; leave unset for evergreen topics",
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ]
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "description": "Matching sources, most relevant first; read any url in full with crawl",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable identifier for this result; for web results this is the canonical URL"
                },
                "title": {
                  "type": "string",
                  "description": "Human-readable result title"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Canonical URL that clients can cite and users can open"
                },
                "text": {
                  "type": "string",
                  "description": "Result snippet or extracted page text when available"
                },
                "metadata": {
                  "type": "object",
                  "description": "Additional source metadata",
                  "additionalProperties": true
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      }
    },
    {
      "name": "news",
      "title": "News search",
      "description": "Search current news when the user asks about recent events, announcements, or coverage. Returns citable article results with title, URL, snippet, and optional extracted text.",
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": []
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ],
        "openai/toolInvocation/invoking": "Searching news…",
        "openai/toolInvocation/invoked": "News results"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Short, focused news query"
          },
          "max_results": {
            "type": "number",
            "minimum": 1,
            "maximum": 50,
            "description": "How many articles the answer needs; a handful suits most questions, more suits broad coverage",
            "default": 10
          },
          "search_service": {
            "type": "string",
            "description": "News engine to use; hackernews returns Hacker News discussions instead of publisher articles",
            "default": "bing",
            "enum": [
              "google",
              "bing",
              "duckduckgo",
              "yahoo",
              "hackernews"
            ]
          },
          "crawl_results": {
            "type": "number",
            "minimum": 0,
            "description": "Number of top articles to retrieve as full pages. Each successful retrieval adds 1 credit to the base 1-credit news request",
            "default": 0
          },
          "include_sites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "News domains to include",
            "default": []
          },
          "exclude_sites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "News domains to exclude",
            "default": []
          },
          "time_range": {
            "type": "string",
            "description": "Only return articles published within this window; use day for breaking news",
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ]
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "description": "Matching sources, most relevant first; read any url in full with crawl",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable identifier for this result; for web results this is the canonical URL"
                },
                "title": {
                  "type": "string",
                  "description": "Human-readable result title"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Canonical URL that clients can cite and users can open"
                },
                "text": {
                  "type": "string",
                  "description": "Result snippet or extracted page text when available"
                },
                "metadata": {
                  "type": "object",
                  "description": "Additional source metadata",
                  "additionalProperties": true
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      }
    },
    {
      "name": "crawl",
      "title": "Read a web page",
      "description": "Read a public web page supplied by the user or returned by search. Returns its title, URL, and main content as text, so you can answer from the full page instead of a snippet.",
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": []
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Address of the page to read, such as a link the user shared or a URL from search results"
          }
        },
        "required": [
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for this result; for web results this is the canonical URL"
              },
              "title": {
                "type": "string",
                "description": "Human-readable result title"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Canonical URL that clients can cite and users can open"
              },
              "text": {
                "type": "string",
                "description": "Result snippet or extracted page text when available"
              },
              "metadata": {
                "type": "object",
                "description": "Additional source metadata",
                "additionalProperties": true
              }
            },
            "required": [
              "id",
              "title",
              "url"
            ],
            "description": "The page that was read; text holds its main content"
          }
        },
        "required": [
          "result"
        ]
      }
    },
    {
      "name": "sitemap",
      "title": "Discover links on a site",
      "description": "Discover related public links from a page or domain when the user wants to explore a site's structure or available pages. Returns a list of absolute URLs found on that site, which can then be read with crawl.",
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": []
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public page or domain URL whose links should be discovered"
          }
        },
        "required": [
          "url"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "links": {
            "type": "array",
            "description": "Absolute URLs discovered on the site, without titles or page content",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "required": [
          "links"
        ]
      }
    },
    {
      "name": "trending",
      "title": "Explore trending topics",
      "description": "List currently trending repositories or stories from GitHub or Hacker News when the user asks what is popular now. Returns each item's title, URL, and a short description when the platform provides one.",
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": []
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "search_service": {
            "type": "string",
            "description": "Where to look: GitHub for popular open-source repositories, Hacker News for stories developers are discussing",
            "enum": [
              "github",
              "hackernews"
            ],
            "default": "github"
          },
          "max_results": {
            "type": "number",
            "minimum": 1,
            "maximum": 50,
            "description": "How many trending items the answer needs, from the top of the list",
            "default": 10
          }
        },
        "required": [
          "search_service"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "description": "Trending items reported by the platform",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "description": "Repository name or story headline"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Link to the repository or story"
                },
                "description": {
                  "type": "string",
                  "description": "Repository summary or story context, when available"
                }
              },
              "required": [
                "title",
                "url"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      }
    },
    {
      "name": "ask",
      "title": "Ask across sources",
      "description": "Search several sources at once from a natural-language request when the right engine is unclear. Search1API picks up to five engines (web, Hacker News, Reddit, GitHub, X, arXiv, Wikipedia, and more) and a time window from the wording, then returns up to 10 citable results ranked by relevance, plus the intent it used and any engines that failed. Costs 5 credits per call; use search when you already know the engine.",
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": []
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "description": "What the user is looking for, in their own words; naming a platform (\"on Reddit\", \"papers\") or a period (\"this week\") steers which engines and time window are used"
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "object",
            "description": "Keywords, engines, and time window that were used",
            "properties": {
              "search_query": {
                "type": "string",
                "description": "Keywords sent to the engines"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Engines that were searched"
              },
              "time_range": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Recency window inferred from the request, or null for any time",
                "enum": [
                  "day",
                  "week",
                  "month",
                  "year",
                  null
                ]
              }
            },
            "required": [
              "search_query",
              "sources",
              "time_range"
            ]
          },
          "results": {
            "type": "array",
            "description": "Up to 10 sources across the chosen engines, most relevant first",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable identifier for this result; for web results this is the canonical URL"
                },
                "title": {
                  "type": "string",
                  "description": "Human-readable result title"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Canonical URL that clients can cite and users can open"
                },
                "text": {
                  "type": "string",
                  "description": "Result snippet or extracted page text when available"
                },
                "metadata": {
                  "type": "object",
                  "description": "Additional source metadata",
                  "additionalProperties": true
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ]
            }
          },
          "errors": {
            "type": "array",
            "description": "Engines that failed while others completed",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "source",
                "message"
              ]
            }
          }
        },
        "required": [
          "intent",
          "results",
          "errors"
        ]
      }
    },
    {
      "name": "render_results",
      "title": "Render the results",
      "description": "Present already retrieved source results as source cards when the host supports UI, with a complete readable text list otherwise. Use when the user wants to browse sources or a visual list helps the task. Pass existing results in the desired order; never invent source URLs or factual titles. Does not search, crawl, fetch URLs, verify sources, or consume search credits. Do not call for intermediate research results or when a text answer is sufficient.",
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": []
        }
      ],
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": []
          }
        ],
        "openai/toolInvocation/invoking": "Preparing results…",
        "openai/toolInvocation/invoked": "Results ready"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Heading shown above the cards, such as the research topic"
          },
          "results": {
            "type": "array",
            "minItems": 0,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "description": "The id from the original search result; the server falls back to the URL when there is none"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "Source title exactly as the search returned it; never invent or rewrite it"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://",
                  "maxLength": 2048,
                  "description": "Link to the source as the search returned it, never one carrying credentials"
                },
                "text": {
                  "type": "string",
                  "maxLength": 2000,
                  "description": "Snippet or faithful excerpt from the source, not a full page or a model-written answer"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Metadata from the original result, such as the publication date; never credentials or UI details"
                }
              },
              "required": [
                "title",
                "url"
              ]
            },
            "description": "Already retrieved results, in the order to display. No new search is performed."
          }
        },
        "required": [
          "results"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "description": "Number of results in this rendered list, not a provider-wide search total."
          },
          "results": {
            "type": "array",
            "minItems": 0,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "description": "The id from the original search result; the server falls back to the URL when there is none"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "Source title exactly as the search returned it; never invent or rewrite it"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://",
                  "maxLength": 2048,
                  "description": "Link to the source as the search returned it, never one carrying credentials"
                },
                "text": {
                  "type": "string",
                  "maxLength": 2000,
                  "description": "Snippet or faithful excerpt from the source, not a full page or a model-written answer"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Metadata from the original result, such as the publication date; never credentials or UI details"
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ]
            }
          }
        },
        "required": [
          "title",
          "total",
          "results"
        ]
      }
    }
  ]
}
